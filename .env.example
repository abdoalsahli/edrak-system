# SQL Server (the production database)
DATABASE_URL="sqlserver://HOST:1433;database=edrak_system;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"
NEXTAUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

