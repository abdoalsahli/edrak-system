generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  RECEPTIONIST
  MANAGER
  ACCOUNTANT
  THERAPIST // signs in to see their own schedule and record session outcomes
}

enum PatientType {
  ADULT
  CHILD
}

enum ServiceDeliveryType {
  SINGLE_SESSION
  PROGRAM
}

enum BillingCycleType {
  MONTHLY
  PER_N_SESSIONS
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum SessionStatus {
  PENDING
  COMPLETED
  ABSENT
  CANCELLED_BY_PATIENT
  CANCELLED_BY_CENTER
}

enum AppointmentStatus {
  SCHEDULED
  DELIVERED
  CANCELLED
}

enum ProgramStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  CANCELLED
}

/// Workflow of a treatment plan or a follow-up report
enum CaseDocStatus {
  DRAFT // the therapist is still writing it
  SUBMITTED // sent to management for review
  APPROVED // reviewed and accepted
  RETURNED // sent back to the therapist with a note
}

/// How far a plan goal got by the end of its cycle
enum GoalAchievement {
  ACHIEVED
  PARTIAL
  NOT_ACHIEVED
}

enum BillingCycleStatus {
  OPEN
  INVOICED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

// ─── AUTHENTICATION & STAFF ───────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Auth.js required fields
  sessions AuthSession[]
  accounts Account[]

  // Set when role = THERAPIST
  therapist Therapist?
  // Set for the other staff (manager, reception, accounts)
  employee  Employee?

  // Audit references
  createdSessions       Session[]              @relation("SessionCreatedBy")
  scheduledAppointments Appointment[]          @relation("AppointmentScheduledBy")
  createdPrograms       Program[]              @relation("ProgramCreatedBy")
  issuedInvoices        Invoice[]              @relation("InvoiceIssuedBy")
  receivedPayments      Payment[]              @relation("PaymentReceivedBy")
  uploadedDocuments     Document[]
  plansReviewed         TreatmentPlan[]        @relation("PlanReviewedBy")
  plansCreated          TreatmentPlan[]        @relation("PlanCreatedBy")
  reportsReviewed       FollowUpReport[]       @relation("ReportReviewedBy")
  reportsCreated        FollowUpReport[]       @relation("ReportCreatedBy")
  updatedSettings       SystemSetting[]
  sessionAuditLogs      SessionAuditLog[]
  therapistTransferLogs TherapistTransferLog[] @relation("TransferPerformedBy")
  paidCommissions       TherapistCommission[]  @relation("CommissionPaidBy")
  issuedDisbursements   Disbursement[]         @relation("DisbursementIssuedBy")
  issuedSettlements     Settlement[]           @relation("SettlementIssuedBy")

  @@map("users")
}

// Auth.js tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Therapist {
  id              String          @id @default(cuid())
  fullName        String
  specialty       String?
  phone           String?
  isActive        Boolean         @default(true)
  commissionType  CommissionType? // PERCENTAGE or FIXED
  commissionRate  Decimal?        @db.Decimal(5, 2) // used when type = PERCENTAGE (e.g. 30.00 = 30%)
  commissionFixed Decimal?        @db.Decimal(10, 2) // used when type = FIXED (amount per session)
  // Login for the therapist portal (role THERAPIST)
  userId          String?         @unique
  createdAt       DateTime        @default(now())

  availability          TherapistAvailability[]
  availabilityOverrides TherapistAvailabilityOverride[]
  programs              Program[]
  appointments          Appointment[]
  commissions           TherapistCommission[]
  fromTransfers         TherapistTransferLog[]          @relation("TransferFromTherapist")
  toTransfers           TherapistTransferLog[]          @relation("TransferToTherapist")
  disbursements         Disbursement[]
  ledgerAccount         LedgerAccount?
  user                  User?                           @relation(fields: [userId], references: [id])
  plans                 TreatmentPlan[]
  reports               FollowUpReport[]

  @@map("therapists")
}

/// موظف — staff who are not therapists (reception, accounts, management, …).
/// A login is optional: someone who never uses the system has no user.
model Employee {
  id        String   @id @default(cuid())
  fullName  String
  jobTitle  String?
  phone     String?
  isActive  Boolean  @default(true)
  userId    String?  @unique
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("employees")
}

// ─── CONFIGURATION ────────────────────────────────────────────────────────────

model Service {
  id                       String              @id @default(cuid())
  name                     String
  description              String?
  deliveryType             ServiceDeliveryType
  defaultSessionsPerWeek   Int?
  defaultTotalSessions     Int?
  defaultDurationMin       Int                 @default(60)
  defaultBillingCycleType  BillingCycleType?
  defaultBillingCycleValue Int?
  defaultPrice             Decimal?            @db.Decimal(10, 2)
  isActive                 Boolean             @default(true)
  createdAt                DateTime            @default(now())

  sessions Session[]
  programs Program[]

  @@map("services")
}

// center_name, center_phone, center_address, center_logo_path only
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt

  updatedByUser User @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}

model CenterHours {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0=Sunday … 6=Saturday
  openTime  String // "HH:mm"
  closeTime String // "HH:mm"
  isOpen    Boolean @default(true)

  @@unique([dayOfWeek])
  @@map("center_hours")
}

model CenterHoliday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  description String?

  @@map("center_holidays")
}

model Room {
  id       String  @id @default(cuid())
  name     String
  isActive Boolean @default(true)

  appointments Appointment[]

  @@map("rooms")
}

model TherapistAvailability {
  id          String @id @default(cuid())
  therapistId String
  dayOfWeek   Int // 0=Sunday … 6=Saturday
  startTime   String // "HH:mm"
  endTime     String // "HH:mm"

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@unique([therapistId, dayOfWeek])
  @@map("therapist_availability")
}

model TherapistAvailabilityOverride {
  id           String   @id @default(cuid())
  therapistId  String
  overrideDate DateTime @db.Date
  isAvailable  Boolean
  startTime    String? // null when isAvailable=false (fully blocked)
  endTime      String?
  reason       String?

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@unique([therapistId, overrideDate])
  @@map("therapist_availability_overrides")
}

// ─── PATIENTS ─────────────────────────────────────────────────────────────────

model Patient {
  id          String      @id @default(cuid())
  fullName    String
  dob         DateTime?   @db.Date
  gender      String?
  phone       String?
  address     String?
  nationalId  String?     @unique
  patientType PatientType @default(ADULT)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  guardian      Guardian?
  sessions      Session[]
  programs      Program[]
  invoices      Invoice[]
  payments      Payment[]
  documents     Document[]
  disbursements Disbursement[]
  ledgerAccount LedgerAccount?

  @@map("patients")
}

model Guardian {
  id           String  @id @default(cuid())
  patientId    String  @unique
  fullName     String
  relationship String?
  phone        String?
  nationalId   String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("guardians")
}

// ─── SESSIONS (Clinical Record — Immutable) ───────────────────────────────────

model Session {
  id                    String        @id @default(cuid())
  patientId             String
  serviceId             String
  programId             String?
  programSequenceNumber Int?
  status                SessionStatus @default(PENDING)
  price                 Decimal?      @db.Decimal(10, 2) // agreed value for THIS session, entered at booking
  isCharged             Boolean       @default(false) // absence/cancellation charged by the user's decision
  commissionAmount      Decimal?      @db.Decimal(10, 2) // therapist commission agreed for THIS session
  outcomeNotes          String?       @db.Text
  deliveredAt           DateTime?
  createdBy             String
  createdAt             DateTime      @default(now())

  patient           Patient              @relation(fields: [patientId], references: [id])
  service           Service              @relation(fields: [serviceId], references: [id])
  program           Program?             @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdByUser     User                 @relation("SessionCreatedBy", fields: [createdBy], references: [id])
  appointments      Appointment[]
  invoiceLines      InvoiceLine[]
  auditLogs         SessionAuditLog[]
  documents         Document[]
  commission        TherapistCommission?
  standaloneInvoice Invoice?             @relation("StandaloneInvoice")

  @@unique([programId, programSequenceNumber])
  @@index([patientId])
  @@index([programId])
  @@map("sessions")
}

// ─── APPOINTMENTS (Calendar Slot — Mutable) ───────────────────────────────────

model Appointment {
  id                    String            @id @default(cuid())
  sessionId             String
  therapistId           String
  roomId                String?
  date                  DateTime          @db.Date
  startTime             String // "HH:mm"
  endTime               String // "HH:mm"
  status                AppointmentStatus @default(SCHEDULED)
  // Rescheduling: cancel old + create new with originalAppointmentId pointing to cancelled
  isMakeup              Boolean           @default(false)
  originalAppointmentId String?
  isInsuranceCovered    Boolean           @default(false)
  insuranceProviderId   String?
  insuranceClaimRef     String?
  scheduledBy           String
  createdAt             DateTime          @default(now())
  deletedAt             DateTime?

  session             Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  therapist           Therapist          @relation(fields: [therapistId], references: [id])
  room                Room?              @relation(fields: [roomId], references: [id])
  scheduledByUser     User               @relation("AppointmentScheduledBy", fields: [scheduledBy], references: [id])
  insuranceProvider   InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  originalAppointment Appointment?       @relation("AppointmentReschedule", fields: [originalAppointmentId], references: [id])
  replacements        Appointment[]      @relation("AppointmentReschedule")

  @@index([date, status])
  @@index([therapistId, date])
  @@map("appointments")
}

// ─── PROGRAMS ─────────────────────────────────────────────────────────────────

model Program {
  id                      String        @id @default(cuid())
  patientId               String
  therapistId             String
  serviceId               String
  startDate               DateTime      @db.Date
  expectedEndDate         DateTime      @db.Date
  sessionsPerWeek         Int
  originalPlannedSessions Int
  plannedSessions         Int
  sessionPrice            Decimal?      @db.Decimal(10, 2) // agreed price per session for this program
  sessionCommission       Decimal?      @db.Decimal(10, 2) // agreed therapist commission per session
  status                  ProgramStatus @default(ACTIVE)
  cancellationReason      String?
  notes                   String?       @db.Text
  createdBy               String
  createdAt               DateTime      @default(now())

  patient       Patient                @relation(fields: [patientId], references: [id])
  therapist     Therapist              @relation(fields: [therapistId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  createdByUser User                   @relation("ProgramCreatedBy", fields: [createdBy], references: [id])
  sessions      Session[]
  billingCycles BillingCycle[]
  transferLogs  TherapistTransferLog[]
  invoice       Invoice?
  plans         TreatmentPlan[]

  @@index([patientId])
  @@map("programs")
}

// ─── CASE PLANS & FOLLOW-UP REPORTS ─────────────────────────────────────────
// A program runs in cycles («دورات») of sessionsPerWeek × 4 sessions (usually 12).
// Each cycle opens with a treatment plan and closes with a follow-up report;
// management reviews both.

/// الخطة العلاجية — the therapist's plan for one cycle of a program
model TreatmentPlan {
  id            String        @id @default(cuid())
  programId     String
  cycleNumber   Int
  fromSequence  Int // first session of the cycle (programSequenceNumber)
  toSequence    Int // last session of the cycle
  therapistId   String
  planDate      DateTime      @db.Date
  caseSummary   String        @db.Text
  longTermGoals String        @db.Text
  methods       String        @db.Text
  focusAreas    Json // string[] — developmental areas this cycle
  notes         String?       @db.Text
  status        CaseDocStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewNote    String?       @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  program    Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  therapist  Therapist       @relation(fields: [therapistId], references: [id])
  reviewedBy User?           @relation("PlanReviewedBy", fields: [reviewedById], references: [id])
  createdBy  User            @relation("PlanCreatedBy", fields: [createdById], references: [id])
  goals      PlanGoal[]
  report     FollowUpReport?

  @@unique([programId, cycleNumber])
  @@map("treatment_plans")
}

/// A short-term goal of a plan; the follow-up report rates it
model PlanGoal {
  id          String           @id @default(cuid())
  planId      String
  text        String           @db.Text
  sortOrder   Int
  achievement GoalAchievement?

  plan TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_goals")
}

/// تقرير المتابعة — written at the end of a cycle, against its plan
model FollowUpReport {
  id               String        @id @default(cuid())
  planId           String        @unique
  therapistId      String
  reportDate       DateTime      @db.Date
  diagnosis        String        @db.Text
  progressLevel    String // ACHIEVED | PARTIAL | NONE, or free text («أخرى»)
  changes          Json // string[] — noticed changes
  parentCommitment String // COMMITTED | PARTIAL | NOT_COMMITTED, or free text
  obstacles        Json // string[]
  recommendations  String        @db.Text
  status           CaseDocStatus @default(DRAFT)
  submittedAt      DateTime?
  reviewNote       String?       @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  plan       TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  therapist  Therapist     @relation(fields: [therapistId], references: [id])
  reviewedBy User?         @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  createdBy  User          @relation("ReportCreatedBy", fields: [createdById], references: [id])

  @@map("follow_up_reports")
}

// ─── BILLING ──────────────────────────────────────────────────────────────────

model InsuranceProvider {
  id          String  @id @default(cuid())
  name        String
  contactInfo String?
  notes       String? @db.Text

  appointments Appointment[]

  @@map("insurance_providers")
}

model BillingCycle {
  id               String             @id @default(cuid())
  programId        String
  cycleNumber      Int
  cycleType        BillingCycleType
  cycleValue       Int
  periodStart      DateTime           @db.Date
  periodEnd        DateTime           @db.Date
  expectedSessions Int                @default(0)
  status           BillingCycleStatus @default(OPEN)

  program  Program   @relation(fields: [programId], references: [id])
  invoices Invoice[]

  @@unique([programId, cycleNumber])
  @@index([programId])
  @@map("billing_cycles")
}

model Invoice {
  id             String        @id @default(cuid())
  billingCycleId String?
  programId      String?       @unique // auto-invoice for programs (one per program)
  sessionId      String?       @unique // auto-invoice for standalone sessions
  patientId      String
  issuedBy       String
  issueDate      DateTime      @db.Date
  dueDate        DateTime?     @db.Date
  totalAmount    Decimal       @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  status         InvoiceStatus @default(DRAFT)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  billingCycle      BillingCycle? @relation(fields: [billingCycleId], references: [id])
  program           Program?      @relation(fields: [programId], references: [id])
  standaloneSession Session?      @relation("StandaloneInvoice", fields: [sessionId], references: [id])
  patient           Patient       @relation(fields: [patientId], references: [id])
  issuedByUser      User          @relation("InvoiceIssuedBy", fields: [issuedBy], references: [id])
  lines             InvoiceLine[]
  payments          Payment[]

  @@index([patientId, status])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  sessionId   String?
  description String
  qty         Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@map("invoice_lines")
}

model Payment {
  id              String   @id @default(cuid())
  voucherNumber   String   @unique // قبض-2026-00001
  invoiceId       String? // legacy: receipts are now posted to an account, not an invoice
  accountId       String? // the current account credited by this receipt
  cashAccountId   String? // which drawer / bank received it
  patientId       String?
  paymentDate     DateTime @db.Date
  amount          Decimal  @db.Decimal(10, 2)
  paymentMethodId String
  referenceNumber String?
  receivedBy      String
  notes           String?
  createdAt       DateTime @default(now())

  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  account        LedgerAccount? @relation(fields: [accountId], references: [id])
  cashAccount    CashAccount?   @relation(fields: [cashAccountId], references: [id])
  paymentMethod  PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  patient        Patient?       @relation(fields: [patientId], references: [id])
  receivedByUser User           @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])

  @@index([invoiceId])
  @@index([accountId])
  @@index([paymentMethodId])
  @@map("payments")
}

// ─── DOCUMENTS ────────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(cuid())
  patientId  String
  programId  String?
  sessionId  String?
  title      String
  filePath   String
  fileType   String
  uploadedBy String
  uploadedAt DateTime @default(now())
  notes      String?

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  session        Session? @relation(fields: [sessionId], references: [id])
  uploadedByUser User     @relation(fields: [uploadedBy], references: [id])

  @@map("documents")
}

// ─── AUDIT ────────────────────────────────────────────────────────────────────

model SessionAuditLog {
  id            String   @id @default(cuid())
  sessionId     String
  action        String
  previousValue Json?
  newValue      Json?
  performedBy   String
  performedAt   DateTime @default(now())

  session         Session @relation(fields: [sessionId], references: [id])
  performedByUser User    @relation(fields: [performedBy], references: [id])

  @@index([sessionId])
  @@map("session_audit_log")
}

model TherapistTransferLog {
  id              String   @id @default(cuid())
  patientId       String
  programId       String
  fromTherapistId String
  toTherapistId   String
  transferDate    DateTime @db.Date
  reason          String?
  performedBy     String
  performedAt     DateTime @default(now())

  program         Program   @relation(fields: [programId], references: [id])
  fromTherapist   Therapist @relation("TransferFromTherapist", fields: [fromTherapistId], references: [id])
  toTherapist     Therapist @relation("TransferToTherapist", fields: [toTherapistId], references: [id])
  performedByUser User      @relation("TransferPerformedBy", fields: [performedBy], references: [id])

  @@map("therapist_transfer_log")
}

// ─── COMMISSIONS ─────────────────────────────────────────────────────────────

model TherapistCommission {
  id             String         @id @default(cuid())
  therapistId    String
  sessionId      String         @unique // one commission record per delivered session
  commissionType CommissionType
  rate           Decimal?       @db.Decimal(5, 2) // set when type = PERCENTAGE
  baseAmount     Decimal?       @db.Decimal(10, 2) // invoice total; null when type = FIXED
  amount         Decimal        @db.Decimal(10, 2) // final amount owed
  isEarned       Boolean        @default(false) // true once the session was actually delivered
  isPaid         Boolean        @default(false)
  paidAt         DateTime?
  paidBy         String?
  disbursementId String? // the سند صرف that paid this commission
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  therapist    Therapist     @relation(fields: [therapistId], references: [id])
  session      Session       @relation(fields: [sessionId], references: [id])
  paidByUser   User?         @relation("CommissionPaidBy", fields: [paidBy], references: [id])
  disbursement Disbursement? @relation(fields: [disbursementId], references: [id])

  @@map("therapist_commissions")
}

// ─── FINANCE: CASH ACCOUNTS, VOUCHERS & EXPENSES ──────────────────────────────

enum CashAccountType {
  CASH // صندوق نقدي
  BANK // حساب بنكي
}

enum DisbursementType {
  COMMISSION // عمولة أخصائي
  REFUND // استرداد لمريض
  EXPENSE // مصروف تشغيلي
  SALARY // راتب
  OTHER
}

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  SUPPLIES
  MAINTENANCE
  MARKETING
  GOVERNMENT
  OTHER
}

/// A place money physically sits: a cash drawer or a bank account.
model CashAccount {
  id             String          @id @default(cuid())
  name           String // "الصندوق الرئيسي" / "بنك الراجحي"
  type           CashAccountType
  accountNumber  String? // IBAN or bank account no.
  openingBalance Decimal         @default(0) @db.Decimal(12, 2)
  isActive       Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())

  receipts       Payment[]
  disbursements  Disbursement[]
  paymentMethods PaymentMethod[]
  ledgerAccount  LedgerAccount?  @relation("CashLedger")

  @@map("cash_accounts")
}

/// Outgoing money: سند صرف. Covers commissions, refunds, expenses and salaries.
model Disbursement {
  id              String           @id @default(cuid())
  voucherNumber   String           @unique // صرف-2026-00001
  type            DisbursementType
  accountId       String? // the current account debited by this payment voucher
  cashAccountId   String
  amount          Decimal          @db.Decimal(12, 2)
  paymentDate     DateTime         @db.Date
  paymentMethodId String

  // Optional counterparties
  therapistId     String? // COMMISSION / SALARY
  patientId       String? // REFUND
  expenseCategory ExpenseCategory? // EXPENSE

  description     String
  referenceNumber String?
  issuedBy        String
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  cashAccount   CashAccount           @relation(fields: [cashAccountId], references: [id])
  paymentMethod PaymentMethod         @relation(fields: [paymentMethodId], references: [id])
  account       LedgerAccount?        @relation(fields: [accountId], references: [id])
  therapist     Therapist?            @relation(fields: [therapistId], references: [id])
  patient       Patient?              @relation(fields: [patientId], references: [id])
  issuedByUser  User                  @relation("DisbursementIssuedBy", fields: [issuedBy], references: [id])
  commissions   TherapistCommission[]

  @@index([cashAccountId])
  @@index([paymentMethodId])
  @@index([accountId])
  @@index([paymentDate])
  @@index([type])
  @@map("disbursements")
}

/// طرق الدفع — user-defined; each one posts to its own cash box or bank account,
/// so documents can be sorted by how the money moved.
model PaymentMethod {
  id            String   @id @default(cuid())
  name          String   @unique // "نقداً" / "تحويل مصرفي" / "موبي كاش"
  cashAccountId String
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  cashAccount   CashAccount    @relation(fields: [cashAccountId], references: [id])
  payments      Payment[]
  disbursements Disbursement[]

  @@index([cashAccountId])
  @@map("payment_methods")
}

/// Per-year sequential numbering for financial documents.
model DocumentCounter {
  id         String @id @default(cuid())
  docType    String // RECEIPT | DISBURSEMENT
  year       Int
  lastNumber Int    @default(0)

  @@unique([docType, year])
  @@map("document_counters")
}

// ─── CURRENT ACCOUNTS (حسابات جارية) ──────────────────────────────────────────
// Every party has one account; every financial document posts entries to it.
// Balances and statements are read from ledger_entries only — a single source of truth.

enum AccountKind {
  PATIENT
  THERAPIST
  EXPENSE
  CUSTOM
  CASH // a cash box or bank account — nature DEBIT (an asset)
}

/// How the balance is read. DEBIT: balance = debit − credit (patients, expenses).
/// CREDIT: balance = credit − debit (therapists and other payables).
enum AccountNature {
  DEBIT
  CREDIT
}

enum LedgerSource {
  OPENING
  INVOICE
  RECEIPT
  PAYMENT
  COMMISSION
  SETTLEMENT
}

enum SettlementType {
  DISCOUNT // خصم
  WRITE_OFF // إعدام دين
  CORRECTION // تصحيح
  TRANSFER // تحويل بين حسابين
  OTHER
}

model LedgerAccount {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  kind            AccountKind
  nature          AccountNature
  patientId       String?          @unique
  therapistId     String?          @unique
  cashAccountId   String?          @unique // set when this account IS a cash box / bank
  expenseCategory ExpenseCategory? @unique // system expense account for a category
  isActive        Boolean          @default(true)
  notes           String?
  createdAt       DateTime         @default(now())

  patient           Patient?       @relation(fields: [patientId], references: [id])
  therapist         Therapist?     @relation(fields: [therapistId], references: [id])
  cashAccount       CashAccount?   @relation("CashLedger", fields: [cashAccountId], references: [id])
  entries           LedgerEntry[]
  receipts          Payment[]
  disbursements     Disbursement[]
  settlementsDebit  Settlement[]   @relation("SettlementDebit")
  settlementsCredit Settlement[]   @relation("SettlementCredit")

  @@index([kind])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id          String       @id @default(cuid())
  accountId   String
  date        DateTime     @db.Date
  debit       Decimal      @default(0) @db.Decimal(12, 2)
  credit      Decimal      @default(0) @db.Decimal(12, 2)
  description String
  sourceType  LedgerSource
  sourceId    String // invoice / payment / disbursement / session / settlement id
  reference   String? // voucher number shown on statements
  createdBy   String?
  createdAt   DateTime     @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, date])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

/// تسوية — a non-cash adjustment. One side only (discount, write-off, correction)
/// or both sides (a transfer between two accounts).
model Settlement {
  id              String         @id @default(cuid())
  voucherNumber   String         @unique // STL-2026-00001
  type            SettlementType
  date            DateTime       @db.Date
  amount          Decimal        @db.Decimal(12, 2)
  debitAccountId  String?
  creditAccountId String?
  description     String
  notes           String?        @db.Text
  issuedBy        String
  createdAt       DateTime       @default(now())

  debitAccount  LedgerAccount? @relation("SettlementDebit", fields: [debitAccountId], references: [id])
  creditAccount LedgerAccount? @relation("SettlementCredit", fields: [creditAccountId], references: [id])
  issuedByUser  User           @relation("SettlementIssuedBy", fields: [issuedBy], references: [id])

  @@index([date])
  @@map("settlements")
}
